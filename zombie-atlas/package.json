{
  "name": "zombie-atlas",
  "version": "1.0.0",
  "description": "Interactive treemap, hierarchy and dependency atlas for the decompiled Project Zomboid source tree",
  "scripts": {
    "data": "node tools/extract.mjs",
    "validate": "node tools/validate.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --dev",
    "serve": "node tools/serve.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/validate.mjs && node --import ./tools/test/ts-resolve.mjs --test tools/test/unit/*.test.mjs && node tools/test/runner.mjs",
    "test:unit": "node --import ./tools/test/ts-resolve.mjs --test tools/test/unit/*.test.mjs",
    "test:browser": "node tools/test/runner.mjs",
    "test:shots": "node tools/test/runner.mjs --shots"
  },
  "type": "module",
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/node": "^26.5.1",
    "playwright": "^1.63.0",
    "tree-sitter-java": "^0.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "web-tree-sitter": "^0.27.0"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "solid-js": "^1.9.15"
  },
  "private": true
}
